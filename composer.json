{
    "name": "hacmanchester/membership-system",
    "description": "Hackspace Manchester Member System",
    "authors": [
        {
            "name": "Hackspace Manchester",
            "email": "board@hacman.org.uk"
        }
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.0.2",
        "gocardless/gocardless-pro": "^4.28",
        "guzzlehttp/guzzle": "^7.15.2",
        "guzzlehttp/psr7": "^2.13",
        "inertiajs/inertia-laravel": "^0.6.11",
        "intervention/image": "2.*",
        "laracasts/presenter": "~0.2.7",
        "laravel-notification-channels/telegram": "^5.0",
        "laravel/framework": "^10.48",
        "laravel/tinker": "^2.10.1",
        "michelf/php-markdown": "~1.4",
        "nesbot/carbon": "^2.0.0",
        "rap2hpoutre/laravel-log-viewer": "^2.4.0",
        "sentry/sentry-laravel": "^4.13.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.12",
        "doctrine/dbal": "^3.0",
        "fakerphp/faker": "^1.9.1",
        "filp/whoops": "~2.17.0",
        "larastan/larastan": "^2.9",
        "laravel/legacy-factories": "^1.3",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.10",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "BB\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [],
        "pre-update-cmd": [],
        "post-update-cmd": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-create-project-cmd": [
            "php -r \"copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "php-http/discovery": true,
            "kylekatarnls/update-helper": true
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-d5tc-s1qs-h781": "CVE-2026-102279, XSS in the debug error page. Only reachable with APP_DEBUG=true; production runs with it off. Fixed in Laravel 12.69 / 13.30.",
                    "PKSA-m5cs-t1y6-qpcs": "Temporary signed URL path confusion. The app creates and verifies no signed URLs (no signed routes, no `signed` middleware, no package that uses them). Fixed in Laravel 12.61.1 / 13.12.",
                    "PKSA-3r5d-mb8f-1qw9": "CRLF injection through the `email` validation rule. Mitigated in-app: BB\\Validators\\CustomValidator::validateEmail() rejects CR/LF for every `email` rule (tests/unit/Validators/EmailCrlfValidationTest). Fixed in Laravel 12.60 / 13.10.",
                    "PKSA-mdq4-51ck-6kdq": "CVE-2026-48019 (the 9.x-12.x entry for the same issue as PKSA-3r5d-mb8f-1qw9): CRLF injection through the `email` validation rule. Mitigated in-app: BB\\Validators\\CustomValidator::validateEmail() rejects CR/LF for every `email` rule (tests/unit/Validators/EmailCrlfValidationTest)."
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    }
}
