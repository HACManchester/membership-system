includes:
    - ./vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app
    level: 8
    ignoreErrors:
        # Level 6 also asks for a type on every parameter, return value and property,
        # and for the value types of every array. That's ~870 findings across most
        # files, and adding native types risks runtime TypeErrors. Better turned on
        # a file at a time than all at once. The null-safety and union checks of
        # levels 7-8 still apply.
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
        - identifier: missingType.parameter
        - identifier: missingType.return
        - identifier: missingType.property
