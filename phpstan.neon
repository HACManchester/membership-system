includes:
    - ./vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app
    level: 8
    ignoreErrors:
        # Level 6 also asks for a type on every parameter, return value and property,
        # and for the value types of every array. That's ~870 findings across most
        # files, and adding native types risks runtime TypeErrors. Revisit with
        # Larastan 3 (Laravel 11+). The null-safety and union checks of levels 7-8
        # still apply.
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
        - identifier: missingType.parameter
        - identifier: missingType.return
        - identifier: missingType.property
        # GoCardlessPro SDK resources expose their data via __get() magic, so accessing
        # "protected" properties like ->id and ->status works at runtime by design.
        - '#^Access to protected property GoCardlessPro\\Resources\\#'
        # The SDK's service classes also carry `@method get()` / `cancel()` / ...
        # annotations with no parameters, contradicting their real signatures
        # (e.g. get($identity, $params = [])), and PHPStan trusts the annotation.
        # The calls are exercised against the real API by GoCardlessSandboxTest.
        - '#^Method GoCardlessPro\\Services\\[A-Za-z]+Service::[a-z]+\(\) invoked with \d+ parameters?, 0 required\.$#'
