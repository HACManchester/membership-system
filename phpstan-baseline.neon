parameters:
	ignoreErrors:
		-
			message: '#^Unable to resolve the template type TGroupKey in call to method Illuminate\\Support\\Collection\<\(int\|string\),mixed\>\:\:groupBy\(\)$#'
			identifier: argument.templateType
			count: 1
			path: app/Console/Commands/Payments/AuditSubscriptionCharges.php

		-
			message: '#^Cannot access property \$id on BB\\Entities\\Course\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: app/Console/Commands/PopulateCourseIdInTrainingRecords.php

		-
